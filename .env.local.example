# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_PROJECT_ID=your-project-ref

# Server-only: never expose to the browser or client bundles
# Used for admin scripts and POST /api/waitlist (inserts into waitlist_signups)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# POST /api/waitlist — abuse throttling (in-memory per serverless instance; see docs/PRODUCTION_SECURITY.md)
# WAITLIST_RATE_LIMIT_MAX=30
# WAITLIST_RATE_LIMIT_WINDOW_SEC=60
# WAITLIST_MAX_BODY_BYTES=4096

# Resend — waitlist confirmation emails (POST /api/waitlist). Domain must be verified in Resend.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# Optional hard guard: block send when FROM domain does not match this verified domain.
# RESEND_VERIFIED_DOMAIN=your-verified-domain.com
# Keep false in production; set true only for temporary sandbox testing.
# RESEND_ALLOW_SANDBOX_FROM=false

# -----------------------------------------------------------------------------
# Content ops / newsletter pipeline — automation & gates (production + local)
# Runbook: docs/features/RUNBOOK-content-ops.md | Triggers: /api/content-ops/automation-run, /api/content-ops/daily-snapshot
# In Vercel: set these under Project → Settings → Environment Variables (Production; Preview if needed).
# Never commit real secrets — copy from a password manager into Vercel and into local .env.local only for testing.
# -----------------------------------------------------------------------------

# Shared secret for automation callers. GET ?token=... must match; POST uses Authorization: Bearer <same>.
# Required in production if you use token-based triggers (manual curl, Cursor schedules, non-cron clients).
CONTENT_OPS_AUTOMATION_TOKEN=

# Primary policy: cursor | Emergency fallback only: vercel-cron (must align caller source + cron headers; see RUNBOOK).
# Omitted in deploy → same as `cursor` (see src/lib/content-ops/automation-config.ts). Vercel UI "no results" for
# this name only means implicit default — still set explicitly in Production for operator clarity + RUNBOOK preflight.
CONTENT_OPS_AUTOMATION_RUNTIME=cursor

# Optional: Slack or custom HTTPS webhook for structured content-ops alerts (server-only).
# CONTENT_OPS_ALERT_WEBHOOK_URL=

# Alert thresholds and gate tuning (defaults live in code if unset)
# CONTENT_OPS_ALERT_FAILED_COUNT_THRESHOLD=3
# CONTENT_OPS_ALERT_REVIEW_BACKLOG_THRESHOLD=20
# CONTENT_OPS_GATE50_FAIL_RATIO_TARGET_PERCENT=20
# CONTENT_OPS_QUEUE_AUTO_APPROVE_MIN_CONFIDENCE=0.8
# CONTENT_OPS_QUEUE_AUTO_APPROVE_MIN_QUALITY_SCORE=16
# When true, queue auto-approval may follow schedule-mode behavior (see pipeline-runner).
# CONTENT_OPS_QUEUE_AUTO_APPROVE_SCHEDULED=false
# CONTENT_OPS_RETRY_FAILED_BATCH_SIZE=
# CONTENT_OPS_PUBLISH_BATCH_SIZE=
# Scripts: gate51 trend / runs invariant (override lookbacks for CLI only)
# CONTENT_OPS_GATE51_MIN_DAY_BUCKETS=2
# CONTENT_OPS_GATE51_LOOKBACK_DAYS=7
# CONTENT_OPS_RUNS_INVARIANT_LOOKBACK_HOURS=168
# Optional: consecutive UTC-day streak window for runs-invariant JSON (default 14)
# CONTENT_OPS_RUNS_INVARIANT_CONSECUTIVE_WINDOW_DAYS=14

# Digital products (Supabase Storage bucket name — create bucket + policies in dashboard)
# CONTENT_STORAGE_BUCKET=elevate-content

# When true, only emails in `catalog_purchase_allowlist` (see migration 014) may start
# catalog checkout (Toss intent/confirm) / related server checks. Add emails in /admin/purchase-allowlist.
# CATALOG_CHECKOUT_REQUIRE_ALLOWLIST=false

# Catalog billing UI: lemon (default — Lemon hosted checkout URLs) | toss (Toss Payments PoC widget).
# NEXT_PUBLIC_CATALOG_PAYMENT_PROVIDER=lemon
# Slug → Lemon Share/checkout URL for /dashboard/billing?product=<slug> (public URLs only).
# NEXT_PUBLIC_LEMON_CHECKOUT_URL_BY_SLUG={"my-guide":"https://your-store.lemonsqueezy.com/checkout/buy/..."}

# When true, only emails in `prompt_studio_beta_allowlist` (migration 016) may open /dashboard/studio.
# Manage list in /admin/prompt-studio-allowlist. Default false: placeholder visible to all signed-in users.
# STUDIO_BETA_REQUIRE_ALLOWLIST=false

# Cursor MCP: Supabase — create at https://supabase.com/dashboard/account/tokens
# (Personal Access Token — NOT the service_role JWT)
SUPABASE_ACCESS_TOKEN=

# Optional: Google Stitch MCP (design prototyping)
# STITCH_GOOGLE_API_KEY=

# App (local dev). Production: https://elevate.ai.kr (no trailing slash; match Vercel + Supabase Site URL)
# Supabase → Authentication → Redirect URLs must include http://localhost:3000/auth/callback (and 127.0.0.1 if used) or OAuth falls back to Site URL and PKCE breaks — see docs/SOCIAL_AUTH.md
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Search Console — HTML tag verification (content= value only; optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Naver Search Advisor — optional override for <meta name="naver-site-verification" /> (default in src/lib/seo/site-verification.ts)
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_APP_NAME=Elevate
# next-intl time zone (SSR/client consistency; default Asia/Seoul)
# NEXT_PUBLIC_APP_TIME_ZONE=Asia/Seoul

# PostHog (optional — product analytics; https://posthog.com/ )
# Project API key from PostHog → Project settings (phc_…).
# This app does NOT read NEXT_PUBLIC_POSTHOG_KEY; use PROJECT_TOKEN below for the browser SDK.
#
# Required for client events (posthog-js): must be NEXT_PUBLIC_* so it is available in the bundle.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EU ingest: https://eu.i.posthog.com
#
# Optional alias some teams / docs use for the same Project API key (phc_…). It is NOT read by
# PostHogRoot (client); duplicate the value into NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN for analytics to work.
# POSTHOG_KEY=phc_...

# Toss Payments (PoC — see docs/adr/ADR-001-toss-payments-poc.md)
# API 개별 연동: MID + 클라이언트/시크릿 (서버에서 시크릿만 비밀 유지)
# TOSS_MERCHANT_ID=
# TOSS_CLIENT_KEY=live_ck_...
# TOSS_SECRET_KEY=live_sk_...
# 결제위젯 연동 시
# NEXT_PUBLIC_TOSS_WIDGET_CLIENT_KEY=live_gck_...
# TOSS_WIDGET_SECRET_KEY=live_gsk_...
# TOSS_SECURITY_KEY= (대시보드에서 복사)

# Lemon Squeezy (global MoR — see docs/adr/ADR-004-lemon-squeezy-global-payments.md)
# Webhook signing secret from Lemon → Settings → Webhooks (same value as LEMON_SQUEEZY_WEBHOOK_SECRET).
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# Server-only: API key from Lemon → Settings → API (never expose to the browser).
# LEMON_SQUEEZY_API_KEY=
# Numeric store ID from Lemon (Settings → Stores, or GET /v1/stores).
# LEMON_SQUEEZY_STORE_ID=
# When true, checkout sessions use Lemon test mode (pair with test API key / test store).
# LEMON_SQUEEZY_TEST_MODE=false
# Optional: map Lemon variant_id → content_products.slug when custom_data has no slug/id, e.g. {"12345":"my-guide"}.
# LEMON_SQUEEZY_VARIANT_TO_CONTENT_SLUG=

# Polar (blog subscriptions)
# Public checkout link used by blog paywall/pricing. Create in Polar dashboard (Checkout Links).
# NEXT_PUBLIC_POLAR_CHECKOUT_LINK=https://buy.polar.sh/polar_cl_...
# Optional server-side override for the same checkout link.
# POLAR_CHECKOUT_LINK=https://buy.polar.sh/polar_cl_...
# Organization token (all-scopes token is okay for now; server-only).
# POLAR_ACCESS_TOKEN=
# Backward-compatible alias if you already use this key name.
# POLAR_API_KEY=
# Webhook secret from Polar Webhooks settings (server-only).
# POLAR_WEBHOOK_SECRET=polar_whs_...
# Recommended checkout redirect targets (configure in Polar Checkout Link dashboard):
# Success URL: https://yourdomain.com/subscription/success?checkout_id={CHECKOUT_ID}
# Return URL:  https://yourdomain.com/subscription/cancel
# Webhook endpoint URL (configure in Polar dashboard):
# https://yourdomain.com/api/webhooks/polar

# Optional: Google AI (future features)
# GEMINI_API_KEY=

# Studio Productions — tool integrations v2 (ADR-006; org credentials + server adapters)
# See docs/adr/ADR-006-studio-provider-integrations-v2.md
# In-app links to each vendor’s key pages: /dashboard/productions/integrations
# NEXT_PUBLIC_STUDIO_INTEGRATIONS_UI=true
# STUDIO_INTEGRATIONS_ENABLED=false
# STUDIO_INTEGRATIONS_ENCRYPTION_KEY=
#
# YouTube channel OAuth (in-app uploads). Authorized redirect URI in Google Cloud must match exactly, e.g.:
# http://localhost:3000/api/integrations/youtube/oauth/callback
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/oauth/callback

# Optional CLI only: pnpm run db:seed-admin (create/reset user via Auth API — do not commit real passwords)
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=
#
# Cursor SDK (programmatic agents; server/CI only)
# Required for scripts/blog-autopublish-sdk.mjs and GitHub Actions blog autopublish workflow.
# CURSOR_API_KEY=
# Optional model id override for SDK runs.
# CURSOR_MODEL=gpt-5.5-medium
# Optional: enable/disable local SDK autopublish script execution.
# BLOG_AUTOPUBLISH_ENABLED=false
# Optional: local/CI script topic queue path override.
# BLOG_AUTOPUBLISH_TOPICS_PATH=docs/blog/automation/topics.json
#
# Dashboard: `/dashboard` is allowed only for profiles with dashboard_access=true (migration 037).
# The server needs SUPABASE_SERVICE_ROLE_KEY to read that column. Grant access in SQL, e.g.:
#   update public.profiles set dashboard_access = true where email = 'you@company.com';
# Optional: pnpm run db:seed-admin sets dashboard_access for ADMIN_EMAIL.

# Platform /admin console access: when ADMIN_EMAIL and/or PLATFORM_ADMIN_EMAILS is set, only those
# emails (comma-separated for PLATFORM_ADMIN_EMAILS) may open /admin. ADMIN_EMAIL is always merged
# into the allowlist. If neither variable is set, any organization admin (profiles.role = admin) may
# access /admin (legacy).
# PLATFORM_ADMIN_EMAILS=ops@yourcompany.com,other@yourcompany.com

# Playwright E2E (password login → dashboard). Never commit real values.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

# Video assembly (FFmpeg): Next.js dev often does not inherit Homebrew PATH. Point to binaries explicitly:
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# Or: brew install ffmpeg  (then ensure `which ffmpeg` works in the same environment as `pnpm dev`)
#
# Subtitle burn-in: libass needs a CJK-capable font. The Fly worker Dockerfile installs fonts-noto-cjk.
# Local sync mode: install Noto (e.g. brew install --cask font-noto-sans-cjk) or set a font your system has:
# VIDEO_ASSEMBLY_SUBTITLE_FONT=Noto Sans CJK KR
# Optional: extra fonts directory for libass (rarely needed if fontconfig finds system fonts)
# VIDEO_ASSEMBLY_SUBTITLE_FONTSDIR=/path/to/fonts
#
# Video assembly: default is async (enqueue `studio_video_assembly_jobs`). Use the same Supabase project as
# your Fly worker so local `pnpm dev` can enqueue and the worker completes jobs. Set sync only to run ffmpeg
# on this machine without a worker (requires FFMPEG_PATH / brew install ffmpeg).
# STUDIO_VIDEO_ASSEMBLY_MODE=sync
# STUDIO_VIDEO_ASSEMBLY_MODE=async
#
# Worker process (see docs/VIDEO_ASSEMBLY_WORKER.md): requires NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# and the same CONTENT_STORAGE_BUCKET as the app. Optional: WORKER_POLL_IDLE_MS=2500
#
# Per-scene user clip uploads (content storage): max file size in bytes (default set in code if unset).
# SCENE_UPLOAD_MAX_BYTES=524288000

# Studio Productions: load demo episodes + artifacts on /dashboard/productions (empty list only).
# Do not enable in production. Restart `pnpm dev` after changing.
# ENABLE_STUDIO_DEMO_SEED=true

# CLI: pnpm run db:seed-demo-studio — same demo rows via service role (no browser).
# Set ONE of: STUDIO_DEMO_ORG_ID=<uuid> OR STUDIO_DEMO_USER_EMAIL=<dashboard login email>
# Optional: append --force to insert even when episodes already exist.
# STUDIO_DEMO_USER_EMAIL=you@company.com
