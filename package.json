{
  "name": "elevate",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:i18n": "vitest run tests/unit/messages-locale-parity.test.ts",
    "test:watch": "vitest tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "db:seed-demo-studio": "tsx scripts/seed-demo-studio-productions.ts",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "og:default": "node scripts/build-og-default.mjs",
    "og:default:webp": "node scripts/build-og-default.mjs --webp",
    "db:types": "node scripts/gen-db-types.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "@tosspayments/tosspayments-sdk": "^2.6.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "next-intl": "^4.8.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.364.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  },
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": "1.1.12",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "vite@>=7.1.0 <=7.3.1": ">=7.3.2"
    }
  }
}
